COMPOSE_PROJECT_NAME=school-guestbook
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

NGINX_HTTP_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AI_PORT=8001

POSTGRES_DB=guestbook
POSTGRES_USER=guestbook
POSTGRES_PASSWORD=change-me-db
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=guestbook
DB_USERNAME=guestbook
DB_PASSWORD=change-me-db

REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-minio
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=guestbook
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/guestbook
AWS_USE_PATH_STYLE_ENDPOINT=true
FILESYSTEM_DISK=s3

AI_SERVICE_URL=http://insightface-service:8000
AI_SERVICE_TOKEN=change-me-ai-token
PHONE_HASH_KEY=change-me-phone-hash-key
AI_MODEL_NAME=buffalo_l
AI_MODEL_VERSION=buffalo_l
AI_MOCK_MODE=true
AI_DETECTION_SIZE=640
AI_MIN_FACE_SIZE=80
AI_MATCH_THRESHOLD=0.48
AI_REQUEST_TIMEOUT=10
AI_PROVIDERS=CPUExecutionProvider

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=Buku Tamu Sekolah
NEXT_PUBLIC_CAMERA_FACING_MODE=user

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

DEFAULT_ADMIN_NAME=Super Admin
DEFAULT_ADMIN_EMAIL=admin@school.local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
AUTO_MIGRATE=true
AUTO_SEED=true
